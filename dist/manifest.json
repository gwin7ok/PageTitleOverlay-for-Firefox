{
  "manifest_version": 2,
  "name": "PageTitleOverlay for FF",
  "version": "0.2.0",
  "short_name": "PageTitleOverlay",
  "description": "Displays the page title in a small overlay; configurable position, colors, and enabled state.",
  "permissions": [
    "<all_urls>",
    "storage",
    "contextMenus"
  ],
  "browser_action": {
    "default_icon": "icon48.png",
    "default_title": "PageTitleOverlay for Firefox"
  },
  "background": {
    "scripts": [
      "page-title-overlay-background.js"
    ],
    "persistent": true
  },
  "options_ui": {
    "page": "page-title-overlay-options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "PageTitleOverlay-for-FF@gwin7ok.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page-title-overlay-content_script.js"
      ],
      "css": [
        "page-title-overlay-style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png"
  }
}