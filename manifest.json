{
  "manifest_version": 2,
  "name": "Status Title Overlay (Waterfox)",
  "version": "0.1",
  "short_name": "StatusTitle",
  "description": "Displays page title in a small overlay near the bottom, hide on mouse/Shift — WebExtension version.",
  "permissions": ["<all_urls>", "storage"],
  "browser_action": {
    "default_icon": "icon48.png",
    "default_title": "Status Title Overlay"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "status-title-overlay@local",
      "strict_min_version": "56.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png"
  }
}
